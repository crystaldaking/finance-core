{
    "name": "crystaldaking/finance-core",
    "description": "Framework-agnostic PHP financial core for money, assets, ledgering, fees, audit, events and idempotency.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/crystaldaking/finance-core",
    "keywords": [
        "accounting",
        "audit",
        "decimal",
        "finance",
        "fintech",
        "idempotency",
        "ledger",
        "money",
        "php-sdk"
    ],
    "authors": [
        {
            "name": "crystaldaking"
        }
    ],
    "support": {
        "issues": "https://github.com/crystaldaking/finance-core/issues",
        "source": "https://github.com/crystaldaking/finance-core"
    },
    "require": {
        "php": "^8.5",
        "brick/math": "^0.17",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.33 || ^0.35",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.2",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Crystal\\Finance\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crystal\\Finance\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover build/logs/clover.xml --coverage-html build/coverage --coverage-text --only-summary-for-coverage-text",
        "coverage:check": "php tools/check-coverage.php build/logs/clover.xml 90",
        "coverage": [
            "@test:coverage",
            "@coverage:check"
        ],
        "mutation": "php -d pcov.enabled=1 vendor/bin/infection --threads=max",
        "analyse:phpstan": "phpstan analyse --memory-limit=1G",
        "analyse:psalm": "psalm --no-cache",
        "analyse": [
            "@analyse:phpstan",
            "@analyse:psalm"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "composer validate --strict",
            "@cs",
            "@analyse",
            "@test"
        ],
        "hardening": [
            "@qa",
            "@coverage",
            "@mutation"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    }
}
